{
  "name": "fitted",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @rb/web build && pnpm --filter @rb/server build",
    "start": "node apps/server/dist/index.js",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@types/node": "^26.6.4"
  }
}
